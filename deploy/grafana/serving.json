{
  "uid": "inference-serving",
  "title": "Serving",
  "schemaVersion": 39,
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "TTFT",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Inter-token latency",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "End-to-end latency",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue wait",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "KV cache",
      "targets": [
        {
          "refId": "A",
          "expr": "max(vllm:gpu_cache_usage_perc)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Running",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Waiting",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(door_requests_waiting)"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Tokens per second",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outcomes",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(door_requests_total[5m]))"
        }
      ]
    }
  ]
}
